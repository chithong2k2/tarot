rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: username, password, role, full_name, status, created_at
    //
    // Collection: sales
    // Fields: reader_id, sale_id, customer_name, package_name, amount, tip, date, created_at
    //
    // Collection: shifts
    // Fields: shift_name, start_time, end_time
    //
    // Collection: reader_shifts / sale_shifts
    // Fields: user_id, shift_id, day_of_week
    //
    // Collection: operating_costs
    // Fields: description, amount, date, created_at
    //
    // Collection: settings
    // Fields: is_locked
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Domain Validators
    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 &&
             data.password is string && data.password.size() > 0 &&
             data.role in ['manager', 'reader', 'sale'] &&
             data.full_name is string && data.full_name.size() > 0;
    }

    function isValidSale(data) {
      return data.reader_id is string && data.sale_id is string &&
             data.customer_name is string && data.package_name is string &&
             data.amount is number && data.date is string;
    }

    // For now, we allow access to get the app running.
    // WARNING: This is a prototype. Please implement Firebase Auth for real security.
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /sales/{saleId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /reader_shifts/{regId} {
      allow read, write: if true;
    }

    match /sale_shifts/{regId} {
      allow read, write: if true;
    }

    match /operating_costs/{costId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}

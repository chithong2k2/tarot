{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user (manager, reader, or sale)",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "reader", "sale"] },
        "full_name": { "type": "string" },
        "bank_account": { "type": "string" },
        "commission_percent": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "password", "role", "full_name"]
    },
    "SaleRecord": {
      "title": "Sale Record",
      "description": "A record of a tarot reading sale",
      "type": "object",
      "properties": {
        "reader_id": { "type": "string" },
        "sale_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "package_name": { "type": "string" },
        "amount": { "type": "number" },
        "tip": { "type": "number" },
        "date": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["reader_id", "sale_id", "customer_name", "package_name", "amount", "date"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Definition of a work shift",
      "type": "object",
      "properties": {
        "shift_name": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" }
      },
      "required": ["shift_name", "start_time", "end_time"]
    },
    "ShiftRegistration": {
      "title": "Shift Registration",
      "description": "A user registered for a specific shift on a specific day",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "shift_id": { "type": "string" },
        "day_of_week": { "type": "string" }
      },
      "required": ["user_id", "shift_id", "day_of_week"]
    },
    "OperatingCost": {
      "title": "Operating Cost",
      "description": "Business expenses",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "date"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global system configuration",
      "type": "object",
      "properties": {
        "is_locked": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of system users"
    },
    "sales": {
      "schema": "SaleRecord",
      "description": "Collection of sale transactions"
    },
    "shifts": {
      "schema": "Shift",
      "description": "Collection of shift definitions"
    },
    "reader_shifts": {
      "schema": "ShiftRegistration",
      "description": "Registrations for readers"
    },
    "sale_shifts": {
      "schema": "ShiftRegistration",
      "description": "Registrations for sales staff"
    },
    "operating_costs": {
      "schema": "OperatingCost",
      "description": "Collection of business expenses"
    },
    "settings": {
      "schema": "SystemSettings",
      "description": "Global settings"
    }
  }
}
